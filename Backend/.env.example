# ==========================================================
# CẤU HÌNH HỆ THỐNG HYBRID AI (OFFLINE OLLAMA / CLOUD GEMINI)
# ==========================================================

# CỜ CHUYỂN ĐỔI CHẾ ĐỘ:
# USE_LOCAL_LLM=True  -> BẬT cờ: Chạy 100% mạng cục bộ với Ollama (Bảo mật tối đa, không cần internet)
# USE_LOCAL_LLM=False -> TẮT cờ: Chạy Cloud với Google Gemini API (Theo yêu cầu BTC)
USE_LOCAL_LLM=True

# CẤU HÌNH GOOGLE GEMINI (Khi USE_LOCAL_LLM=False)
# Điền API Key do BTC hoặc Google Cloud cung cấp:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CẤU HÌNH OLLAMA CỤC BỘ (Khi USE_LOCAL_LLM=True)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=StrictMentor
